    // "Search inside one document" — each matching provision is its own result.
    function provisionCards(d: any) {
      const subs = (d.sub_results || []).filter((s: any) => s.url.includes('#'));
      return (subs.length ? subs : [{ title: d.meta?.title, url: d.url, excerpt: d.excerpt }]).map((s: any) => {
        const li = el('li', 'rounded-2xl border border-white/10 bg-white/[0.035] p-5 transition-colors hover:border-primary/35');
        li.append(link('block font-[var(--font-display)] text-[16px] font-semibold leading-snug text-foreground hover:text-primary', s.title, s.url));
        const ex = el('p', 'mt-1.5 text-[14px] leading-relaxed text-muted-foreground'); ex.innerHTML = s.excerpt;
