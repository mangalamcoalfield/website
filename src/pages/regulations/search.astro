    }

    async function page() {
      const my = seq;
      const batch = await Promise.all(hits.slice(shown, shown + PAGE).map((h) => h.data()));
      if (my !== seq) return;
      const q = input.value.trim();
      const oneDoc = !!filters().doc && !!q;
      batch.forEach((d) => {
        if (exactUrls.has(d.url.replace(/\/$/, ''))) return;
        if (d.filters?.kind?.[0] === KINDS.statutes) {
          if (oneDoc) provisionCards(d).forEach((c: HTMLElement) => out.append(c));
          else out.append(statuteCard(d, q));
        } else out.append(circularCard(d, q));
      });
      shown += batch.length;
      more.hidden = shown >= hits.length;
    }

    function renderActive() {
      active.replaceChildren();
      for (const s of selects) if (s.value && !s.closest<HTMLElement>('[data-scopes]')!.hidden) {
        const b = el('button', 'chip-x', `${LABEL[s.dataset.filter!]}: ${s.value}`) as HTMLButtonElement;
        b.type = 'button'; b.setAttribute('aria-label', `Remove filter ${LABEL[s.dataset.filter!]}: ${s.value}`);
        b.append(el('span', '', '×'));
        b.addEventListener('click', () => { s.value = ''; pushRun(); });
        active.append(b);
      }
    }

    let pushNext = false;                               // the next URL change is a new history entry
    function syncUrl() {
      const u = new URL(location.href);
      const q = input.value.trim();
      ['q', 'scope', ...selects.map((s) => s.dataset.filter!), 'sort'].forEach((k) => u.searchParams.delete(k));
      if (q) u.searchParams.set('q', q);
      if (scope) u.searchParams.set('scope', scope);
      for (const s of selects) if (s.value) u.searchParams.set(s.dataset.filter!, s.value);
      if (sortSel.value) u.searchParams.set('sort', sortSel.value);
