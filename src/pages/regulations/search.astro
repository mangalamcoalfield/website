    document.addEventListener('keydown', (e) => {
      if (e.key === '/' && document.activeElement !== input && !(e.target as HTMLElement).closest('input,select,textarea')) { e.preventDefault(); input.focus(); }
    });

    // Restore state from the URL (shareable searches; the hub's search box posts here;
    // Back/Forward between searches).
    function restore() {
      const sp = new URLSearchParams(location.search);
      const sc = sp.get('scope');
      setScope(sc === 'statutes' || sc === 'circulars' ? sc : '');
      if (scope === 'circulars') selectTab($('tab-year') as HTMLButtonElement);
      input.value = sp.get('q') || '';
      for (const s of selects) {
        const v = sp.get(s.dataset.filter!);
        const shown = !s.closest<HTMLElement>('[data-scopes]')!.hidden;
        s.value = v && shown && [...s.options].some((o) => o.value === v) ? v : '';
      }
      sortSel.value = sp.get('sort') || '';
    }
    restore();
    addEventListener('popstate', () => { restore(); pushNext = false; run(); });
    if (input.value || selects.some((s) => s.value)) run();
    else input.focus({ preventScroll: true });
  </script>
