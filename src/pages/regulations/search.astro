        exP.length ? `${exP.length} provision${exP.length === 1 ? '' : 's'} by number` : '',
        exC.length ? (num ? `${exC.length} circular${exC.length === 1 ? '' : 's'} numbered ${num.n} of ${num.y}` : `${exC.length} gazette notification${exC.length === 1 ? '' : 's'} by number`) : '',
      ].filter(Boolean).join(' · ');
