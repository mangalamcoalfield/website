---
import Site from '../../layouts/Site.astro';
import ShaderHero from '../../components/magic/ShaderHero.tsx';
import corpus from '../../data/circulars-corpus.json';
import { collectionOf, COLLECTIONS, type CircularEntry } from '../../lib/circulars';

// "Circular Finder" — full-text search over every DGMS circular: the two DGMS
// compilations split into individual circulars, plus the circulars and
// notifications held as individual PDFs in the library. Each circular has its own
// page (regulations/circulars/[id].astro) that Pagefind indexes at build time; this
// page queries that index in the browser. Filters (department, year, collection,
// topic) and sorting work with or without a search term, so "every Legislative
// circular of 2009" is a two-click query. It used to search a hand-written list of
// 123 one-line summaries, so text inside the circulars was unsearchable.
const items = corpus as CircularEntry[];
const total = items.length;

const count = <K extends string>(f: (c: CircularEntry) => K | null) => {
  const m = new Map<K, number>();
  for (const c of items) { const k = f(c); if (k) m.set(k, (m.get(k) ?? 0) + 1); }
  return m;
};
const DEPT_ORDER = ['Technical', 'Legislative', 'General', 'Approval', 'Examination', 'Electrical', 'Occupational Health', 'Safety alerts', 'Gazette notifications', 'Safety conference recommendations', 'Rules & regulations', 'Reports & statistics', 'Not stated'];
const depts = [...count((c) => c.dept)].sort((a, b) => DEPT_ORDER.indexOf(a[0]) - DEPT_ORDER.indexOf(b[0]));
const years = [...count((c) => (c.year ? String(c.year) : 'Undated'))].sort((a, b) => (b[0] === 'Undated' ? -1 : a[0] === 'Undated' ? 1 : +b[0] - +a[0]));
const decades = new Map<string, [string, number][]>();
for (const y of years) {
  const d = y[0] === 'Undated' ? 'Undated' : `${y[0].slice(0, 3)}0s`;
  if (!decades.has(d)) decades.set(d, []);
  decades.get(d)!.push(y);
}
const cols = COLLECTIONS.map((k) => [k, items.filter((c) => collectionOf(c) === k).length] as const).filter(([, n]) => n > 0);
const topics = [...count((c) => (c.section && collectionOf(c) === 'Regulation-wise digest (to 2017)' ? c.section : null))].sort((a, b) => a[0].localeCompare(b[0]));
const DEPT_NOTE: Record<string, string> = {
  'Technical': 'Technical wing, incl. S&T, SOMA, MAMID, Sapicom',
  'Legislative': 'Law, rules and their interpretation',
  'General': 'Administration, jurisdiction, procedure',
  'Approval': 'Approval of equipment and materials',
  'Examination': 'Board of Mining Examinations',
  'Electrical': 'Electrical inspectorate',
  'Occupational Health': 'Medical examination and health',
  'Safety alerts': 'Alerts after accidents',
  'Gazette notifications': 'G.S.R. / S.O. notifications',
  'Safety conference recommendations': 'National Conferences on Safety in Mines',
  'Rules & regulations': 'Rules published by DGMS, in full text',
  'Reports & statistics': 'Statistics of Mines, SANKET, Standard Notes',
  'Not stated': 'Older circulars that name no wing',
};
const newest = Math.max(...items.map((c) => c.year ?? 0));
const oldest = Math.min(...items.filter((c) => c.year).map((c) => c.year!));

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://mangalamcoal.com/' },
    { '@type': 'ListItem', position: 2, name: 'Regulations', item: 'https://mangalamcoal.com/regulations' },
    { '@type': 'ListItem', position: 3, name: 'Circular Finder', item: 'https://mangalamcoal.com/regulations/circulars' },
  ],
};
const searchLd = {
  '@context': 'https://schema.org', '@type': 'WebSite', url: 'https://mangalamcoal.com/',
  potentialAction: { '@type': 'SearchAction', target: 'https://mangalamcoal.com/regulations/circulars?q={search_term_string}', 'query-input': 'required name=search_term_string' },
};
const selectCls = 'w-full rounded-xl border border-white/10 bg-[#0b120e] px-3 py-2.5 text-[13px] text-foreground focus:border-primary focus:outline-none';
---
<Site
  title="DGMS Circular Finder — search every DGMS circular"
  description={`Full-text search across ${total.toLocaleString('en-IN')} DGMS circulars, digest instructions and notifications (${oldest}–${newest}). Filter by department, year, collection and topic; every result opens the circular and its page in the official PDF.`}
  jsonLd={[breadcrumbLd, searchLd]}
>
  <ShaderHero
    client:load compact
    eyebrow="Regulation desk"
    title="DGMS Circular Finder"
    accentWords={1}
    description={`Every DGMS circular in one search — ${total.toLocaleString('en-IN')} circulars, instructions and notifications from ${oldest} to ${newest}, searched word for word.`}
    primary={{ label: 'Back to the library', href: '/regulations' }}
  />

  <section class="relative bg-background pb-24 pt-10">
    <div class="mx-auto max-w-6xl px-6">

      <!-- Search -->
      <div class="rounded-3xl border border-white/10 bg-white/[0.03] p-5 md:p-6">
        <label for="cq" class="mb-2 block text-[12px] font-semibold uppercase tracking-[0.18em] text-primary">Search the full text</label>
        <div class="relative">
          <svg class="pointer-events-none absolute left-4 top-1/2 -translate-y-1/2 text-muted-foreground" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
          <input id="cq" type="search" autocomplete="off" spellcheck="false"
            placeholder='Words, a phrase in "quotes", or a circular number — e.g. headgear · "detaching hook" · 02 of 2009'
            class="w-full rounded-2xl border border-white/10 bg-[#0b120e] py-4 pl-12 pr-24 text-[16px] text-foreground placeholder:text-muted-foreground/70 focus:border-primary focus:outline-none" />
          <kbd class="pointer-events-none absolute right-4 top-1/2 hidden -translate-y-1/2 rounded-md border border-white/15 px-2 py-0.5 text-[11px] text-muted-foreground md:block">/ to search</kbd>
        </div>

        <!-- Filters -->
        <div class="mt-4 grid grid-cols-2 gap-3 md:grid-cols-5">
          <div>
            <label for="f-dept" class="mb-1 block text-[11px] font-semibold uppercase tracking-wide text-muted-foreground">Department</label>
            <select id="f-dept" data-filter="dept" class={selectCls}>
              <option value="">All departments</option>
              {depts.map(([d, n]) => <option value={d}>{d} ({n})</option>)}
            </select>
          </div>
          <div>
            <label for="f-year" class="mb-1 block text-[11px] font-semibold uppercase tracking-wide text-muted-foreground">Year</label>
            <select id="f-year" data-filter="year" class={selectCls}>
              <option value="">All years</option>
              {[...decades].map(([d, ys]) => (
                <optgroup label={d}>{ys.map(([y, n]) => <option value={y}>{y} ({n})</option>)}</optgroup>
              ))}
            </select>
          </div>
          <div>
            <label for="f-col" class="mb-1 block text-[11px] font-semibold uppercase tracking-wide text-muted-foreground">Collection</label>
            <select id="f-col" data-filter="collection" class={selectCls}>
              <option value="">All collections</option>
              {cols.map(([k, n]) => <option value={k}>{k} ({n})</option>)}
            </select>
          </div>
          <div>
            <label for="f-topic" class="mb-1 block text-[11px] font-semibold uppercase tracking-wide text-muted-foreground">Topic (digest)</label>
            <select id="f-topic" data-filter="topic" class={selectCls}>
              <option value="">All topics</option>
              {topics.map(([t, n]) => <option value={t}>{t} ({n})</option>)}
            </select>
          </div>
          <div>
            <label for="f-sort" class="mb-1 block text-[11px] font-semibold uppercase tracking-wide text-muted-foreground">Sort</label>
            <select id="f-sort" class={selectCls}>
              <option value="">Best match</option>
              <option value="desc">Newest first</option>
              <option value="asc">Oldest first</option>
            </select>
          </div>
        </div>
      </div>

      <!-- Results -->
      <div id="results-wrap" class="mt-8" hidden>
        <div class="flex flex-wrap items-center justify-between gap-3">
          <p id="status" class="text-[14px] text-foreground" aria-live="polite"></p>
          <button id="clear" type="button" class="text-[13px] font-semibold text-primary hover:underline">Clear search &amp; filters</button>
        </div>
        <div id="active" class="mt-3 flex flex-wrap gap-2"></div>
        <ol id="results" class="mt-5 flex flex-col gap-3"></ol>
        <div class="mt-6 flex justify-center"><button id="more" type="button" hidden class="rounded-full border border-white/15 bg-white/[0.04] px-6 py-2.5 text-[13px] font-semibold text-foreground transition-colors hover:border-primary hover:text-primary">Show more</button></div>
      </div>

      <!-- Browse (shown when nothing is searched or filtered) -->
      <div id="browse" class="mt-10">
        <div role="tablist" aria-label="Browse circulars" class="flex flex-wrap gap-2 border-b border-white/10">
          <button role="tab" id="tab-year" aria-controls="panel-year" aria-selected="true" class="tab">By year</button>
          <button role="tab" id="tab-dept" aria-controls="panel-dept" aria-selected="false" class="tab">By department</button>
          <button role="tab" id="tab-topic" aria-controls="panel-topic" aria-selected="false" class="tab">By topic</button>
        </div>

        <div id="panel-year" role="tabpanel" aria-labelledby="tab-year" class="pt-6">
          <div class="flex flex-col gap-5">
            {[...decades].map(([d, ys]) => (
              <div>
                <h3 class="mb-2 text-[12px] font-semibold uppercase tracking-[0.16em] text-muted-foreground">{d}</h3>
                <div class="flex flex-wrap gap-2">
                  {ys.map(([y, n]) => (
                    <button type="button" data-set-filter="year" data-value={y} class="pick rounded-xl border border-white/10 bg-white/[0.03] px-3.5 py-2 text-left text-[13px] transition-colors hover:border-primary">
                      <span class="font-semibold text-foreground">{y}</span> <span class="text-muted-foreground">{n}</span>
                    </button>
                  ))}
                </div>
              </div>
            ))}
          </div>
        </div>

        <div id="panel-dept" role="tabpanel" aria-labelledby="tab-dept" class="pt-6" hidden>
          <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
            {depts.map(([d, n]) => (
              <button type="button" data-set-filter="dept" data-value={d} class="pick rounded-2xl border border-white/10 bg-white/[0.03] p-4 text-left transition-colors hover:border-primary">
                <span class="flex items-baseline justify-between gap-3"><span class="font-semibold text-foreground">{d}</span><span class="text-[13px] text-muted-foreground">{n}</span></span>
                <span class="mt-1 block text-[12px] text-muted-foreground">{DEPT_NOTE[d] ?? ''}</span>
              </button>
            ))}
          </div>
        </div>

        <div id="panel-topic" role="tabpanel" aria-labelledby="tab-topic" class="pt-6" hidden>
          <p class="mb-4 text-[13px] text-muted-foreground">The regulation-wise digest of circulars up to 2017, arranged by the subject of the regulation they explain.</p>
          <div class="grid gap-2 sm:grid-cols-2 lg:grid-cols-3">
            {topics.map(([t, n]) => (
              <button type="button" data-set-filter="topic" data-value={t} class="pick flex items-baseline justify-between gap-3 rounded-xl border border-white/10 bg-white/[0.03] px-4 py-3 text-left text-[13px] transition-colors hover:border-primary">
                <span class="font-semibold text-foreground">{t}</span><span class="text-muted-foreground">{n}</span>
              </button>
            ))}
          </div>
        </div>
      </div>

      <p class="mt-12 text-[12px] leading-relaxed text-muted-foreground/80">Sources: the DGMS compilations "DGMS Circulars (up to June 2017)" and "DGMS Circulars 2018–2024", split into individual circulars, and the DGMS circulars and notifications held as individual PDFs in this library. Scanned pages were machine-read and may contain recognition errors; every circular links to its page in the PDF, which is the authoritative text. "Department" is the issuing DGMS wing as stated in the circular's reference; older circulars that name none are marked "Not stated". DGMS may have amended or withdrawn older instructions since.</p>
    </div>
  </section>

  <style is:global>
    .tab { margin-bottom: -1px; border-bottom: 2px solid transparent; padding: .6rem 1rem; font-size: 14px; font-weight: 600; color: hsl(var(--muted-foreground)); }
    .tab:hover { color: hsl(var(--foreground)); }
    .tab[aria-selected="true"] { color: hsl(var(--foreground)); border-color: hsl(var(--primary)); }
    #results mark { background: hsl(var(--primary) / .28); color: hsl(var(--foreground)); border-radius: 3px; padding: 0 2px; }
    .chip-x { display: inline-flex; align-items: center; gap: .4rem; border: 1px solid hsl(var(--primary) / .5); background: hsl(var(--primary) / .1); color: hsl(var(--foreground)); border-radius: 999px; padding: .3rem .75rem; font-size: 12px; font-weight: 600; }
    .chip-x:hover { border-color: hsl(var(--primary)); }
  </style>

  <script>
    type Hit = { data: () => Promise<any> };
    type PF = {
      options: (o: object) => Promise<void>;
      init: () => Promise<void>;
      search: (q: string | null, o?: object) => Promise<{ results: Hit[] } | null>;
      debouncedSearch: (q: string | null, o?: object, ms?: number) => Promise<{ results: Hit[] } | null>;
    };
    const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
    const input = $<HTMLInputElement>('cq');
    const wrap = $('results-wrap'), out = $('results'), status = $('status'), more = $<HTMLButtonElement>('more');
    const browse = $('browse'), active = $('active');
    const selects = Array.from(document.querySelectorAll<HTMLSelectElement>('select[data-filter]'));
    const sortSel = $<HTMLSelectElement>('f-sort');
    const LABEL: Record<string, string> = { dept: 'Department', year: 'Year', collection: 'Collection', topic: 'Topic' };
    const PAGE = 20;
    let pf: PF | null = null, hits: Hit[] = [], shown = 0, seq = 0;

    async function load() {
      if (pf) return pf;
      try {
        const path = '/pagefind/pagefind.js';
        pf = (await import(/* @vite-ignore */ path)) as PF;
        await pf.options({ excerptLength: 38 });
        await pf.init();
      } catch {
        wrap.hidden = false;
        status.textContent = 'Search is unavailable right now. Please try again shortly.';
        pf = null;
      }
      return pf;
    }

    // ---- exact circular-number lookup ("2 of 2009", "02/2009", "Tech circular 2 of 2009")
    type NumRow = { u: string; r: string; t: string; d: string; y: number | null; c: string; p: [number, number][] };
    let numbers: NumRow[] | null = null;
    const ROMAN: Record<string, number> = { i: 1, v: 5, x: 10, l: 50 };
    const roman = (s: string) => [...s].reduce((n, ch, i) => { const v = ROMAN[ch], w = ROMAN[s[i + 1]] ?? 0; return n + (v < w ? -v : v); }, 0);
    const WING_HINT: [RegExp, string][] = [
      [/\b(?:legis|legislative)\b/i, 'Legislative'], [/\b(?:genl|general)\b/i, 'General'], [/\bapproval\b/i, 'Approval'],
      [/\b(?:exam|examination)\b/i, 'Examination'], [/\b(?:oh|occupational)\b/i, 'Occupational Health'],
      [/\belectrical\b/i, 'Electrical'], [/\b(?:tech|technical)\b/i, 'Technical'],
    ];
    function parseNumber(q: string) {
      const m = q.match(/(?:^|[^\d])(\d{1,3}|[ivxl]{1,6})\s*(?:of|\/)\s*((?:19|20)\d{2})\b/i);
      if (!m) return null;
      const n = /^\d/.test(m[1]) ? parseInt(m[1], 10) : roman(m[1].toLowerCase());
      const hint = WING_HINT.find(([re]) => re.test(q))?.[1] ?? '';
      return n > 0 ? { n, y: parseInt(m[2], 10), hint } : null;
    }
    async function exactMatches(q: string, f: Record<string, string>) {
      const num = parseNumber(q);
      if (!num) return [] as NumRow[];
      if (!numbers) {
        try { numbers = await (await fetch('/regulations/circulars/numbers.json')).json(); } catch { numbers = []; }
      }
      return numbers!
        .filter((r) => r.p.some(([n, y]) => n === num.n && y === num.y))
        .filter((r) => (!f.dept || r.d === f.dept) && (!f.year || String(r.y) === f.year) && (!f.collection || r.c === f.collection))
        .sort((a, b) => Number(b.d === num.hint) - Number(a.d === num.hint));
    }
    function exactCard(r: NumRow) {
      const li = el('li', 'rounded-2xl border border-primary/45 bg-primary/[0.06] p-5');
      const top = el('div', 'flex flex-wrap items-center gap-2');
      top.append(el('span', 'rounded-md bg-primary px-2.5 py-1 font-mono text-[12px] font-semibold text-primary-foreground', r.r));
      top.append(el('span', 'rounded-md border border-white/12 px-2 py-0.5 text-[11px] font-semibold uppercase tracking-wide text-muted-foreground', r.d));
      if (r.y) top.append(el('span', 'text-[12px] text-muted-foreground', String(r.y)));
      top.append(el('span', 'ml-auto text-[11px] font-semibold uppercase tracking-wide text-primary', 'Circular number match'));
      const a = el('a', 'mt-2.5 block font-[var(--font-display)] text-[17px] font-semibold leading-snug text-foreground hover:text-primary', r.t) as HTMLAnchorElement;
      a.href = r.u;
      const foot = el('div', 'mt-2 text-[12px] text-muted-foreground/80', r.c);
      li.append(top, a, foot);
      return li;
    }
    let exactUrls = new Set<string>();

    function filters() {
      const f: Record<string, string> = {};
      for (const s of selects) if (s.value) f[s.dataset.filter!] = s.value;
      return f;
    }

    function el(tag: string, cls: string, text?: string) {
      const e = document.createElement(tag); e.className = cls; if (text != null) e.textContent = text; return e;
    }

    function card(d: any, q: string) {
      const li = el('li', 'rounded-2xl border border-white/10 bg-white/[0.035] p-5 transition-colors hover:border-primary/35');
      const top = el('div', 'flex flex-wrap items-center gap-2');
      if (d.meta?.ref) top.append(el('span', 'rounded-md bg-primary/15 px-2.5 py-1 font-mono text-[12px] font-semibold text-primary', d.meta.ref));
      if (d.meta?.dept) top.append(el('span', 'rounded-md border border-white/12 px-2 py-0.5 text-[11px] font-semibold uppercase tracking-wide text-muted-foreground', d.meta.dept));
      const when = d.meta?.date || d.meta?.year;
      if (when) top.append(el('span', 'text-[12px] text-muted-foreground', when));
      const a = el('a', 'mt-2.5 block font-[var(--font-display)] text-[17px] font-semibold leading-snug text-foreground hover:text-primary', d.meta?.title || 'Circular') as HTMLAnchorElement;
      a.href = d.url;
      const ex = el('p', 'mt-2 text-[14px] leading-relaxed text-muted-foreground');
      if (q) ex.innerHTML = d.excerpt;                  // Pagefind's excerpt of our own page text, escaped, with <mark>
      else ex.textContent = (d.content || '').replace(/\s+/g, ' ').slice(0, 240) + '…';
      const foot = el('div', 'mt-3 flex flex-wrap items-center gap-x-4 gap-y-1 text-[12px]');
      foot.append(el('span', 'text-muted-foreground/80', d.filters?.collection?.[0] || ''));
      const read = el('a', 'font-semibold text-primary hover:underline', 'Read full text') as HTMLAnchorElement; read.href = d.url;
      foot.append(read);
      if (d.meta?.pdf) {
        const p = el('a', 'font-semibold text-muted-foreground hover:text-primary', `PDF ${d.meta.pages || ''} ↗`) as HTMLAnchorElement;
        p.href = d.meta.pdf; p.target = '_blank'; p.rel = 'noopener';
        foot.append(p);
      }
      li.append(top, a, ex, foot);
      return li;
    }

    async function page() {
      const my = seq;
      const batch = await Promise.all(hits.slice(shown, shown + PAGE).map((h) => h.data()));
      if (my !== seq) return;
      const q = input.value.trim();
      batch.forEach((d) => { if (!exactUrls.has(d.url.replace(/\/$/, ''))) out.append(card(d, q)); });
      shown += batch.length;
      more.hidden = shown >= hits.length;
    }

    function renderActive() {
      active.replaceChildren();
      for (const s of selects) if (s.value) {
        const b = el('button', 'chip-x', `${LABEL[s.dataset.filter!]}: ${s.value}`) as HTMLButtonElement;
        b.type = 'button'; b.setAttribute('aria-label', `Remove filter ${LABEL[s.dataset.filter!]}: ${s.value}`);
        b.append(el('span', '', '×'));
        b.addEventListener('click', () => { s.value = ''; run(); });
        active.append(b);
      }
    }

    function syncUrl() {
      const u = new URL(location.href);
      const q = input.value.trim();
      ['q', ...selects.map((s) => s.dataset.filter!), 'sort'].forEach((k) => u.searchParams.delete(k));
      if (q) u.searchParams.set('q', q);
      for (const s of selects) if (s.value) u.searchParams.set(s.dataset.filter!, s.value);
      if (sortSel.value) u.searchParams.set('sort', sortSel.value);
      history.replaceState(null, '', u);
    }

    async function run() {
      const q = input.value.trim();
      const f = filters();
      const my = ++seq;
      renderActive(); syncUrl();
      if (!q && !Object.keys(f).length) {
        wrap.hidden = true; browse.hidden = false; out.replaceChildren(); more.hidden = true;
        return;
      }
      browse.hidden = true; wrap.hidden = false;
      const p = await load();
      if (!p || my !== seq) return;
      status.textContent = 'Searching…';
      // With no words, list everything in the chosen filters, newest first unless told otherwise.
      const sortDir = sortSel.value || (q ? '' : 'desc');
      const opts: any = { filters: f };
      if (sortDir) opts.sort = { year: sortDir };
      const [res, exact] = await Promise.all([
        q ? p.debouncedSearch(q, opts, 220) : p.search(null, opts),
        q ? exactMatches(q, f) : Promise.resolve([] as NumRow[]),
      ]);
      if (!res || my !== seq) return;
      hits = res.results; shown = 0; out.replaceChildren();
      exactUrls = new Set(exact.map((r) => r.u));
      exact.forEach((r) => out.append(exactCard(r)));
      const n = hits.length.toLocaleString('en-IN');
      const scope = Object.entries(f).map(([k, v]) => `${LABEL[k].toLowerCase()} ${v}`).join(', ');
      const num = parseNumber(q);
      const lead = exact.length ? `${exact.length} circular${exact.length === 1 ? '' : 's'} numbered ${num!.n} of ${num!.y} · ` : '';
      status.textContent = hits.length || exact.length
        ? `${lead}${n} circular${hits.length === 1 ? '' : 's'}${q ? ` containing “${q}”` : ''}${scope ? ` · ${scope}` : ''}`
        : `No circulars${q ? ` contain “${q}”` : ''}${scope ? ` for ${scope}` : ''}. Try fewer words or remove a filter.`;
      await page();
    }

    input.addEventListener('input', run);
    selects.forEach((s) => s.addEventListener('change', run));
    sortSel.addEventListener('change', run);
    more.addEventListener('click', page);
    $('clear').addEventListener('click', () => { input.value = ''; selects.forEach((s) => (s.value = '')); sortSel.value = ''; run(); input.focus(); });

    // Browse tiles set a filter.
    document.querySelectorAll<HTMLButtonElement>('[data-set-filter]').forEach((b) => b.addEventListener('click', () => {
      const s = selects.find((x) => x.dataset.filter === b.dataset.setFilter);
      if (s) { s.value = b.dataset.value || ''; run(); wrap.scrollIntoView({ behavior: 'smooth', block: 'start' }); }
    }));

    // Tabs (arrow keys move between them).
    const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    function selectTab(t: HTMLButtonElement) {
      tabs.forEach((x) => { const on = x === t; x.setAttribute('aria-selected', String(on)); x.tabIndex = on ? 0 : -1; $(x.getAttribute('aria-controls')!).hidden = !on; });
    }
    tabs.forEach((t, i) => {
      t.tabIndex = i === 0 ? 0 : -1;
      t.addEventListener('click', () => selectTab(t));
      t.addEventListener('keydown', (e) => {
        if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
        const n = tabs[(i + (e.key === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length];
        selectTab(n); n.focus();
      });
    });

    // "/" focuses the search box.
    document.addEventListener('keydown', (e) => {
      if (e.key === '/' && document.activeElement !== input && !(e.target as HTMLElement).closest('input,select,textarea')) { e.preventDefault(); input.focus(); }
    });

    // Restore state from the URL (shareable searches).
    const sp = new URLSearchParams(location.search);
    input.value = sp.get('q') || '';
    for (const s of selects) { const v = sp.get(s.dataset.filter!); if (v && [...s.options].some((o) => o.value === v)) s.value = v; }
    sortSel.value = sp.get('sort') || '';
    if (input.value || selects.some((s) => s.value)) run();
  </script>
