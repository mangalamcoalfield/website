---
import Site from '../layouts/Site.astro';
import ShaderHero from '../components/magic/ShaderHero.tsx';
import ApplicationForm from '../components/ApplicationForm.astro';
import { safeSelect, type Job } from '../lib/supabase';
import { placeholderJobs } from '../data/placeholders';
import { SITE } from '../data/site';

// Data-driven from `jobs` (status='published'); fallback to placeholders.
let jobs = await safeSelect<Job>((c) =>
  c.from('jobs').select('*').eq('status', 'published').order('posted_at', { ascending: false })
);
const usingPlaceholders = jobs.length === 0;
if (usingPlaceholders) jobs = placeholderJobs;

// Department filter tabs (only render depts that currently have openings).
const DEPT_ORDER = ['Mining', 'Mechanical', 'Electrical', 'Admin'];
const depts = DEPT_ORDER.filter((d) => jobs.some((j) => j.dept === d));

const empType = (t: string | null) =>
  /part/i.test(t || '') ? 'PART_TIME' : /contract/i.test(t || '') ? 'CONTRACTOR' : 'FULL_TIME';

// Structured data only for real, published vacancies. The placeholders exist to
// keep the page from looking broken if the database is unreachable or paused —
// emitting JobPosting markup for them would be submitting fabricated vacancies
// to Google, which is both a search-spam violation and a promise of jobs that
// do not exist.
const jobLd = (usingPlaceholders ? [] : jobs).map((j) => ({
  '@context': 'https://schema.org',
  '@type': 'JobPosting',
  title: j.title,
  description: j.description || j.title,
  datePosted: j.posted_at || undefined,
  employmentType: empType(j.type),
  hiringOrganization: { '@type': 'Organization', name: SITE.legalName, sameAs: 'https://mangalamcoal.com', logo: 'https://mangalamcoal.com/mangalam_logo.png' },
  jobLocation: { '@type': 'Place', address: { '@type': 'PostalAddress', streetAddress: j.location || 'Amlabad Colliery, Eastern Jharia Area', addressLocality: 'District Bokaro', addressRegion: 'Jharkhand', addressCountry: 'IN' } },
  ...(j.dept ? { occupationalCategory: j.dept } : {}),
  directApply: true,
}));
---
<Site title="Careers" description="Open roles at Mangalam Coalfield — mining engineers, statutory safety, electrical and mechanical positions. Apply directly with your résumé." jsonLd={jobLd}>
  <ShaderHero
    client:load compact
    eyebrow="Careers"
    title="Build a career in Indian coal mining"
    accentWords={3}
    description="From mining engineers to electrical and statutory roles — join a company that runs its operations to standard."
    primary={{ label: 'See open roles', href: '#roles' }}
  />

  {/* "Life at Amlabad" — the benchmark found every contractor peer carries
      something beyond a bare vacancy list. Employee-welfare facts only. */}
  <section class="relative bg-background pt-20">
    <div class="mx-auto max-w-6xl px-6">
      <div class="rounded-3xl border border-white/10 bg-white/[0.03] p-8 backdrop-blur-sm md:p-10">
        <span class="text-[11px] font-semibold uppercase tracking-[0.28em] text-primary">Life at Amlabad</span>
        <h2 class="mt-3 font-[var(--font-display)] text-3xl font-bold tracking-tight text-foreground">More than a shift roster.</h2>
        <div class="mt-6 grid gap-8 md:grid-cols-2">
          <div>
            <h3 class="font-[var(--font-display)] text-lg font-semibold text-foreground">Your health is checked, on a schedule</h3>
            <p class="mt-2 leading-relaxed text-muted-foreground">
              A health camp runs at the colliery every six months for our own and contractor workforce —
              X-ray, blood, urine and eye examination, with a doctor's advice in person. Around 150 people
              were seen at the July 2026 camp.
              <a href="/safety" class="text-primary hover:underline">More on safety</a>.
            </p>
          </div>
          <div>
            <h3 class="font-[var(--font-display)] text-lg font-semibold text-foreground">And there is a life outside the pit</h3>
            <p class="mt-2 leading-relaxed text-muted-foreground">
              In August 2026 the company held a sports day for employees at Amlabad, inaugurated together
              with Bharat Coking Coal Limited's Eastern Jharia Area management, with the finals played on
              Independence Day. It is there to build team spirit and keep people active between shifts.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="roles" class="relative bg-background py-24">
    <div class="mx-auto max-w-6xl px-6">
      <div class="mb-10 max-w-2xl">
        <span class="text-[11px] font-semibold uppercase tracking-[0.28em] text-primary">Open roles</span>
        <h2 class="mt-3 font-[var(--font-display)] text-4xl font-bold tracking-tight text-foreground md:text-5xl">Current openings.</h2>
        <p class="mt-4 text-muted-foreground">All roles are based at the Amlabad block in the Eastern Jharia Area, Bokaro, Jharkhand unless stated otherwise.</p>
      </div>

      {depts.length > 1 && (
        <div id="deptchips" class="mb-8 flex flex-wrap gap-2.5">
          <button class="deptchip active rounded-full border border-primary bg-primary px-4 py-2 text-[13px] font-semibold text-primary-foreground" data-dept="all">All roles</button>
          {depts.map((d) => (<button class="deptchip rounded-full border border-white/12 px-4 py-2 text-[13px] font-semibold text-muted-foreground transition-colors hover:border-primary" data-dept={d}>{d}</button>))}
        </div>
      )}

      <div id="joblist" class="flex flex-col gap-4">
        {jobs.map((j) => (
          <div class="jobcard flex flex-col items-start justify-between gap-4 rounded-2xl border border-white/10 bg-white/[0.04] p-7 backdrop-blur-sm transition-colors hover:border-primary/30 sm:flex-row sm:items-center" data-dept={j.dept}>
            <div>
              <h3 class="font-[var(--font-display)] text-xl font-semibold text-foreground">{j.title}</h3>
              <div class="mt-2 flex flex-wrap gap-x-4 gap-y-1 text-[13px] text-muted-foreground">
                {j.dept && <span class="text-primary/80">{j.dept}</span>}
                {j.location && <span>{j.location}</span>}
                {j.type && <span>{j.type}</span>}
              </div>
              {j.description && <p class="mt-3 max-w-2xl text-sm text-muted-foreground">{j.description}</p>}
            </div>
            <a href="#apply" class="shrink-0 rounded-xl border border-white/15 bg-white/[0.04] px-5 py-2.5 text-[13px] font-semibold text-foreground transition-colors hover:border-primary hover:text-primary">Apply</a>
          </div>
        ))}
      </div>
      <p id="jobnone" class="hidden py-8 text-center text-muted-foreground">No current openings in this department.</p>
      {usingPlaceholders && (
        <p class="mt-8 text-sm text-muted-foreground">Placeholder roles shown. Live openings are published from the careers pipeline.</p>
      )}
    </div>
  </section>

  <script>
    const chips = document.querySelectorAll('#deptchips .deptchip');
    const cards = Array.from(document.querySelectorAll('#joblist .jobcard')) as HTMLElement[];
    const none = document.getElementById('jobnone');
    chips.forEach((chip) => chip.addEventListener('click', () => {
      chips.forEach((c) => { c.classList.remove('active', 'bg-primary', 'text-primary-foreground', 'border-primary'); c.classList.add('text-muted-foreground', 'border-white/12'); });
      chip.classList.add('active', 'bg-primary', 'text-primary-foreground', 'border-primary'); chip.classList.remove('text-muted-foreground', 'border-white/12');
      const d = (chip as HTMLElement).dataset.dept || 'all';
      let visible = 0;
      cards.forEach((c) => { const show = d === 'all' || c.dataset.dept === d; c.style.display = show ? '' : 'none'; if (show) visible++; });
      none?.classList.toggle('hidden', visible !== 0);
    }));
  </script>

  <section id="apply" class="relative bg-background pb-28">
    <div class="mx-auto max-w-6xl px-6">
      <div class="mb-10 max-w-2xl">
        <span class="text-[11px] font-semibold uppercase tracking-[0.28em] text-primary">Apply</span>
        <h2 class="mt-3 font-[var(--font-display)] text-4xl font-bold tracking-tight text-foreground md:text-5xl">Submit your application.</h2>
        <p class="mt-4 text-muted-foreground">Tell us who you are, choose a role, and attach your résumé. We review every application.</p>
      </div>
      <div class="rounded-3xl border border-white/10 bg-white/[0.02] p-8 backdrop-blur-sm">
        <ApplicationForm jobs={jobs} />
      </div>

      <!-- Recruitment-fraud notice: impersonation of coal-belt employers is common. -->
      <div class="mt-8 rounded-2xl border border-amber-400/25 bg-amber-400/[0.06] p-6">
        <div class="flex items-start gap-3">
          <svg class="mt-0.5 shrink-0 text-amber-400" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 9v4M12 17h.01M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/></svg>
          <div>
            <h3 class="font-[var(--font-display)] text-base font-semibold text-foreground">Beware of recruitment fraud</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
              Mangalam Coalfield <strong class="text-foreground/90">never charges a fee</strong> at any stage of recruitment — not for
              an application, an interview, a medical, training or a job offer. We do not use agents who charge candidates,
              and we will never ask you to deposit money to secure a role.
            </p>
            <p class="mt-3 text-sm leading-relaxed text-muted-foreground">
              Applications are accepted only through this page or from an address ending
              <strong class="text-foreground/90">@mangalamcoal.com</strong>. If someone demands payment in our name, or writes from
              another domain offering a job, please treat it as fraudulent and tell us at
              <a href={`mailto:${SITE.hrEmail}`} class="text-primary underline">{SITE.hrEmail}</a>.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>
</Site>
