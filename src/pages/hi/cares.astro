---
import Site from '../../layouts/Site.astro';
import ShaderHero from '../../components/magic/ShaderHero.tsx';
import { safeSelect, type CsrProject } from '../../lib/supabase';

const projects = await safeSelect<CsrProject>((c) =>
  c.from('csr_projects').select('*').eq('published', true).order('date', { ascending: false })
);
const pill = (s: string) => (s === 'completed' ? 'पूर्ण' : s === 'ongoing' ? 'जारी' : 'प्रस्तावित');
---
<Site
  title="मंगलम केयर्स"
  description="अमलाबाद खदान के आसपास मंगलम का सामुदायिक एवं पर्यावरणीय कार्य — चिकित्सालय, स्वास्थ्य शिविर, वृक्षारोपण और राहत।">
  <ShaderHero
    client:load compact
    eyebrow="मंगलम केयर्स"
    title="सतह के ऊपर का काम भी उतना ही ज़रूरी"
    accentWords={3}
    description="उत्पादन से आगे, मंगलम खदान के आसपास के लोगों और पर्यावरण में निवेश करता है।"
  />

  <section class="relative bg-background pt-14">
    <div class="mx-auto max-w-6xl px-6">
      <div class="grid items-center gap-10 lg:grid-cols-2">
        <div>
          <span class="text-[11px] font-semibold uppercase tracking-[0.2em] text-primary">संस्थापक की इच्छा</span>
          <h2 class="mt-3 font-[var(--font-display)] text-3xl font-bold leading-tight tracking-tight text-foreground md:text-4xl">“अमलाबाद से केवल कोयला नहीं, खुशहाल जीवन भी निकले।”</h2>
          <p class="mt-5 leading-relaxed text-muted-foreground">यही हमारे संस्थापक स्व. श्री श्रीगोपाल अग्रवाल की इच्छा थी। उनकी 60वीं जयंती पर उनकी धर्मपत्नी श्रीमती उर्मिल अग्रवाल ने अमलाबाद में <strong class="text-foreground/80">मंगलम चिकित्सालय</strong> का उद्घाटन किया — जहाँ हमारे कर्मियों और आसपास के गाँवों के लिए इलाज नि:शुल्क है।</p>
          <p class="mt-4 leading-relaxed text-muted-foreground">नीचे दिया गया कार्य उसी इच्छा को आगे ले जाता है।</p>
        </div>
        <div class="overflow-hidden rounded-3xl border border-white/10">
          <img src="/images/mangalam-chikitsalaya.jpg" alt="अमलाबाद कोलियरी में मंगलम चिकित्सालय" class="aspect-[3/2] w-full object-cover" loading="lazy" width="1600" height="1066" />
        </div>
      </div>
    </div>
  </section>

  <section class="relative bg-background py-20">
    <div class="mx-auto max-w-6xl px-6">
      <h2 class="mb-8 font-[var(--font-display)] text-2xl font-bold tracking-tight text-foreground md:text-3xl">हमारे कार्य</h2>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {projects.map((p) => (
          <div class="rounded-2xl border border-white/10 bg-white/[0.04] p-7 backdrop-blur-sm">
            <span class="inline-block rounded-full bg-primary/15 px-3 py-1 text-[11px] font-semibold text-primary">{pill(p.status)}</span>
            <h3 class="mt-4 font-[var(--font-display)] text-lg font-semibold text-foreground">{p.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted-foreground">{p.description}</p>
            {p.impact_numbers && <p class="mt-3 text-sm font-semibold text-primary">{p.impact_numbers}</p>}
          </div>
        ))}
      </div>
      <p class="mt-8 text-[12px] text-muted-foreground/60">परियोजनाओं का विवरण अंग्रेज़ी में दर्ज है; अधिक जानकारी के लिए <a href="/cares" class="text-primary underline">अंग्रेज़ी पृष्ठ</a> देखें।</p>
    </div>
  </section>
</Site>
