---
import Site from '../../layouts/Site.astro';
import ShaderHero from '../../components/magic/ShaderHero.tsx';
import { SITE } from '../../data/site';
import { safeSelect, type Job } from '../../lib/supabase';
import { placeholderJobs } from '../../data/placeholders';

let jobs = await safeSelect<Job>((c) =>
  c.from('jobs').select('*').eq('status', 'published').order('posted_at', { ascending: false })
);
if (jobs.length === 0) jobs = placeholderJobs;
---
<Site
  title="करियर"
  description="मंगलम कोलफील्ड में रिक्तियाँ — माइनिंग इंजीनियर, वैधानिक सुरक्षा, विद्युत एवं यांत्रिक पद। अमलाबाद, बोकारो।">
  <ShaderHero
    client:load compact
    eyebrow="करियर"
    title="खदान के साथ अपना कॅरियर बनाइए"
    accentWords={2}
    description="अमलाबाद के पुनरुद्धार में कुशल लोगों की आवश्यकता है — भूमिगत संचालन, सुरक्षा, विद्युत एवं यांत्रिक अनुरक्षण तथा प्रशासन में।"
  />

  <section class="relative bg-background py-16">
    <div class="mx-auto max-w-6xl px-6">
      <div class="max-w-3xl">
        <span class="text-[11px] font-semibold uppercase tracking-[0.2em] text-primary">वर्तमान रिक्तियाँ</span>
        <h2 class="mt-3 font-[var(--font-display)] text-3xl font-bold tracking-tight text-foreground md:text-4xl">खुले पद</h2>
        <p class="mt-4 leading-relaxed text-muted-foreground">सभी पद अमलाबाद ब्लॉक, पूर्वी झरिया क्षेत्र, बोकारो, झारखंड में स्थित हैं, जब तक अन्यथा न कहा गया हो।</p>
      </div>

      <div class="mt-10 flex flex-col gap-3">
        {jobs.map((j) => (
          <div class="flex flex-wrap items-center justify-between gap-4 rounded-2xl border border-white/10 bg-white/[0.04] p-6 backdrop-blur-sm">
            <div class="min-w-0">
              <h3 class="font-[var(--font-display)] text-lg font-semibold text-foreground">{j.title}</h3>
              <p class="mt-1 text-[13px] text-muted-foreground">{[j.dept, j.type, j.location].filter(Boolean).join(' · ')}</p>
            </div>
            <a href="/careers#apply" class="shrink-0 rounded-xl border border-white/15 bg-white/[0.04] px-5 py-2.5 text-[13px] font-semibold text-foreground transition-colors hover:border-primary hover:text-primary">आवेदन करें</a>
          </div>
        ))}
      </div>

      <!-- आवेदन कैसे करें -->
      <div class="mt-12 rounded-3xl border border-white/10 bg-white/[0.02] p-8 backdrop-blur-sm">
        <h2 class="font-[var(--font-display)] text-2xl font-bold tracking-tight text-foreground">आवेदन कैसे करें</h2>
        <ol class="mt-5 space-y-3 text-sm leading-relaxed text-muted-foreground">
          <li><strong class="text-foreground/85">1.</strong> आवेदन पृष्ठ खोलें और अपना पद चुनें।</li>
          <li><strong class="text-foreground/85">2.</strong> अपना नाम, ई-मेल और मोबाइल नंबर भरें।</li>
          <li><strong class="text-foreground/85">3.</strong> अपना बायोडाटा (résumé) संलग्न करें — PDF या Word।</li>
          <li><strong class="text-foreground/85">4.</strong> सहमति बॉक्स पर निशान लगाकर आवेदन जमा करें।</li>
        </ol>
        <p class="mt-5 text-[13px] leading-relaxed text-muted-foreground/80">आवेदन फ़ॉर्म अंग्रेज़ी में है। सहायता चाहिए तो <a href={`mailto:${SITE.hrEmail}`} class="text-primary underline">{SITE.hrEmail}</a> पर लिखें या {SITE.phone} पर कॉल करें।</p>
        <a href="/careers#apply" class="mt-6 inline-flex items-center gap-2 rounded-xl bg-primary px-6 py-3 text-[14px] font-semibold text-[#10130d] transition-opacity hover:opacity-90">आवेदन फ़ॉर्म खोलें
          <svg width="15" height="15" viewBox="0 0 24 24" aria-hidden="true"><use href="#arrow"/></svg>
        </a>
      </div>

      <!-- भर्ती धोखाधड़ी से सावधान -->
      <div class="mt-8 rounded-2xl border border-amber-400/25 bg-amber-400/[0.06] p-6">
        <div class="flex items-start gap-3">
          <svg class="mt-0.5 shrink-0 text-amber-400" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 9v4M12 17h.01M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/></svg>
          <div>
            <h3 class="font-[var(--font-display)] text-base font-semibold text-foreground">भर्ती धोखाधड़ी से सावधान रहें</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
              मंगलम कोलफील्ड भर्ती के किसी भी चरण में <strong class="text-foreground/90">कोई शुल्क नहीं लेती</strong> — न आवेदन के लिए,
              न साक्षात्कार, मेडिकल, प्रशिक्षण या नियुक्ति के लिए। हम ऐसे किसी अभिकर्ता (एजेंट) का उपयोग नहीं करते जो
              उम्मीदवारों से पैसे लेता हो, और हम कभी भी नौकरी के बदले पैसे जमा करने को नहीं कहेंगे।
            </p>
            <p class="mt-3 text-sm leading-relaxed text-muted-foreground">
              आवेदन केवल इसी वेबसाइट के माध्यम से, या <strong class="text-foreground/90">@mangalamcoal.com</strong> पर समाप्त होने वाले
              ई-मेल पते से स्वीकार किए जाते हैं। यदि कोई हमारे नाम पर पैसे माँगे, तो कृपया इसे धोखाधड़ी मानें और
              <a href={`mailto:${SITE.hrEmail}`} class="text-primary underline">{SITE.hrEmail}</a> पर हमें सूचित करें।
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>
</Site>
