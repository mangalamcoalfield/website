    selects.forEach((s) => s.addEventListener('change', pushRun));
    sortSel.addEventListener('change', pushRun);
    more.addEventListener('click', page);
    scopeBtns.forEach((b, i) => {
      b.addEventListener('click', () => { setScope((b.dataset.scope || '') as Scope); pushRun(); });
      // A radio group is one tab stop; arrow keys move the choice.
      b.addEventListener('keydown', (e) => {
        const d = e.key === 'ArrowRight' || e.key === 'ArrowDown' ? 1 : e.key === 'ArrowLeft' || e.key === 'ArrowUp' ? -1 : 0;
        if (!d) return;
