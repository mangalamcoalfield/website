---
import Site from '../../layouts/Site.astro';
import ShaderHero from '../../components/magic/ShaderHero.tsx';
import { SITE } from '../../data/site';
---
<Site
  title="संपर्क"
  description="मंगलम कोलफील्ड से संपर्क करें — अमलाबाद कोलियरी, पूर्वी झरिया क्षेत्र, जिला बोकारो, झारखंड।">
  <ShaderHero
    client:load compact
    eyebrow="संपर्क"
    title="हमसे बात कीजिए"
    accentWords={1}
    description="पूछताछ, नौकरी, आपूर्ति या स्थानीय समुदाय से जुड़ी किसी बात के लिए — नीचे दिए माध्यमों से हम तक पहुँचें।"
  />

  <section class="relative bg-background py-16">
    <div class="mx-auto max-w-6xl px-6">
      <div class="grid gap-5 md:grid-cols-2">
        <div class="rounded-2xl border border-white/10 bg-white/[0.04] p-7 backdrop-blur-sm">
          <h2 class="font-[var(--font-display)] text-xl font-bold text-foreground">खदान कार्यालय</h2>
          <p class="mt-3 leading-relaxed text-muted-foreground">{SITE.location}</p>
          <h3 class="mt-6 text-[11px] font-semibold uppercase tracking-[0.16em] text-muted-foreground">पंजीकृत कार्यालय</h3>
          <p class="mt-2 leading-relaxed text-muted-foreground">{SITE.regOffice}</p>
          <p class="mt-4 text-[12px] text-muted-foreground/80">CIN: {SITE.cin}</p>
        </div>

        <div class="rounded-2xl border border-white/10 bg-white/[0.04] p-7 backdrop-blur-sm">
          <h2 class="font-[var(--font-display)] text-xl font-bold text-foreground">सीधे संपर्क करें</h2>
          <dl class="mt-5 space-y-4">
            <div>
              <dt class="text-[11px] font-semibold uppercase tracking-[0.16em] text-muted-foreground">दूरभाष</dt>
              <dd class="mt-1"><a href={`tel:${SITE.phoneHref}`} class="text-foreground/90 hover:text-primary">{SITE.phone}</a></dd>
            </div>
            <div>
              <dt class="text-[11px] font-semibold uppercase tracking-[0.16em] text-muted-foreground">सामान्य एवं नौकरी संबंधी</dt>
              <dd class="mt-1"><a href={`mailto:${SITE.hrEmail}`} class="text-foreground/90 hover:text-primary">{SITE.hrEmail}</a></dd>
            </div>
            <div>
              <dt class="text-[11px] font-semibold uppercase tracking-[0.16em] text-muted-foreground">वरिष्ठ प्रबंधन</dt>
              <dd class="mt-1"><a href={`mailto:${SITE.seniorEmail}`} class="text-foreground/90 hover:text-primary">{SITE.seniorEmail}</a></dd>
            </div>
          </dl>
          <a href="/contact" class="mt-7 inline-flex items-center gap-2 rounded-xl bg-primary px-5 py-2.5 text-[13.5px] font-semibold text-[#10130d] transition-opacity hover:opacity-90">ऑनलाइन फ़ॉर्म भरें
            <svg width="14" height="14" viewBox="0 0 24 24" aria-hidden="true"><use href="#arrow"/></svg>
          </a>
          <p class="mt-3 text-[12px] text-muted-foreground/80">फ़ॉर्म अंग्रेज़ी में है; आप हिन्दी में भी लिख सकते हैं।</p>
        </div>
      </div>

      <div class="mt-5 rounded-2xl border border-white/10 bg-white/[0.02] p-7">
        <h2 class="font-[var(--font-display)] text-xl font-bold text-foreground">आस-पास के गाँवों के निवासियों के लिए</h2>
        <p class="mt-3 max-w-3xl leading-relaxed text-muted-foreground">
          यदि खदान के कार्य से आपको कोई असुविधा हो — या आप रोज़गार, प्रशिक्षण अथवा सामुदायिक कार्यों के बारे में जानना चाहें —
          तो उपरोक्त नंबर पर कॉल करें या ई-मेल लिखें। कृपया अपना नाम, गाँव और संपर्क नंबर अवश्य बताएँ ताकि हम आप तक वापस पहुँच सकें।
        </p>
      </div>
    </div>
  </section>
</Site>
