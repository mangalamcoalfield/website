      const noun = scope === 'statutes' ? (f.doc ? 'matching document' : 'document') : scope === 'circulars' ? 'circular' : 'result';
      const scopeTxt = Object.entries(f).map(([k, v]) => `${LABEL[k].toLowerCase()} ${v}`).join(', ');
      const num = parseNumber(q);
