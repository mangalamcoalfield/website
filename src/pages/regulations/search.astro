      exC.forEach((r) => out.append(circularMatchCard(r)));

      // How the results split between the two scopes, as one-click switches.
      split.replaceChildren();
      const kc = res.filters?.kind;
      if (!scope && q && kc) {
        for (const [s, k] of [['statutes', KINDS.statutes], ['circulars', KINDS.circulars]] as const) {
          const n = kc[k] ?? 0;
          if (!n) continue;
          const b = el('button', 'split-b', `${n.toLocaleString('en-IN')} in ${k}`) as HTMLButtonElement;
          b.type = 'button'; b.addEventListener('click', () => { setScope(s); pushRun(); });
