---
import Site from '../layouts/Site.astro';
import ShaderHero from '../components/magic/ShaderHero.tsx';
import { SITE } from '../data/site';

// Press kit. Everything offered here is material we own: our own site photography,
// our own drone footage, our brand marks, and facts already published elsewhere on
// this site. Newspaper clippings are deliberately NOT offered for download — their
// copyright belongs to the publishers, so /news links to them instead.

const DOCS = 'https://docs.mangalamcoal.com/media';

const imagery = [
  { src: '/images/amlabad-aerial-refurb.jpg', title: 'Amlabad from the air — refurbished surface',
    cap: 'The colliery surface after refurbishment, with all four pit headframes and the re-roofed workshops.' },
  { src: '/images/amlabad-aerial-pits.jpg', title: 'The four pit headframes',
    cap: 'A closer aerial across the pit tops, with crews working at the shaft area.' },
  { src: '/images/amlabad-pits.jpg', title: 'The historic headframes at dusk',
    cap: 'Among the oldest working landmarks in the Eastern Jharia Area.' },
  { src: '/images/amlabad-headframe.jpg', title: 'Pit headframe, ground level',
    cap: 'A single headframe at close range.' },
  { src: '/images/mangalam-chikitsalaya.jpg', title: 'Mangalam Chikitsalaya',
    cap: 'The hospital at the colliery, inaugurated February 2026 — free treatment for the workforce and the villages around it.' },
  { src: '/images/chikitsalaya-plaque.jpg', title: 'Chikitsalaya dedication plaque',
    cap: 'The dedication in memory of the founder, Late Shree Gopal Agarwal.' },
];

const facts: [string, string][] = [
  ['Legal name', SITE.legalName],
  ['CIN', SITE.cin],
  ['What we do', 'Mine developer & operator (MDO) — underground coking coal and coal bed methane'],
  ['The mine', 'Amlabad Colliery — a more than century-old underground prime coking-coal mine, closed since 2008'],
  ['Client', 'Bharat Coking Coal Limited (BCCL), a Coal India company'],
  ['Mandate', 'Revival and operation as MDO, on a long-term revenue-sharing basis'],
  ['Location', SITE.location],
  ['Registered office', SITE.regOffice],
];

const ld = {
  '@context': 'https://schema.org', '@type': 'CollectionPage',
  name: 'Media & press kit — Mangalam Coalfield',
  url: 'https://mangalamcoal.com/media',
  isPartOf: { '@type': 'WebSite', name: SITE.name, url: 'https://mangalamcoal.com' },
};
---
<Site title="Media & Press Kit" description="Press kit for Mangalam Coalfield Private Limited — company facts, brand marks, site photography and drone footage of the Amlabad colliery, plus a press contact." jsonLd={ld}>
  <ShaderHero client:load compact eyebrow="Media" title="Press kit" accentWords={1}
    description="Facts, imagery and brand marks for anyone writing about the Amlabad revival. Everything on this page is ours to share, and free to use with attribution to Mangalam Coalfield Private Limited." />

  <section class="relative bg-background pb-4 pt-2">
    <div class="mx-auto max-w-5xl px-6">
      <div class="rounded-3xl border border-primary/20 bg-primary/[0.05] p-7 md:p-8">
        <span class="text-[11px] font-semibold uppercase tracking-[0.28em] text-primary">Press enquiries</span>
        <p class="mt-3 text-[17px] leading-8 text-foreground/90">For interviews, site visits, or anything you need that is not here, write to
          <a href={`mailto:${SITE.seniorEmail}`} class="text-primary underline">{SITE.seniorEmail}</a>
          or call <a href={`tel:${SITE.phoneHref}`} class="text-primary underline">{SITE.phone}</a>.</p>
      </div>
    </div>
  </section>

  <section class="relative bg-background py-14">
    <div class="mx-auto max-w-5xl px-6">
      <h2 class="font-[var(--font-display)] text-3xl font-bold tracking-tight text-foreground md:text-4xl">The company, in brief.</h2>
      <dl class="mt-8 divide-y divide-white/10 overflow-hidden rounded-2xl border border-white/10 bg-white/[0.03]">
        {facts.map(([k, v]) => (
          <div class="flex flex-col gap-1 p-5 sm:flex-row sm:gap-6">
            <dt class="w-full shrink-0 text-[12px] font-semibold uppercase tracking-wide text-primary sm:w-52">{k}</dt>
            <dd class="text-[15px] leading-relaxed text-muted-foreground">{v}</dd>
          </div>
        ))}
      </dl>
      <p class="mt-4 text-[12px] leading-relaxed text-muted-foreground/60">We do not publish production figures, reserves or mine-plan data. For the regulatory framework we operate under, see the <a href="/regulations" class="text-primary hover:underline">regulations library</a>.</p>
    </div>
  </section>

  <section class="relative bg-background pb-14">
    <div class="mx-auto max-w-6xl px-6">
      <div class="mb-8 max-w-2xl">
        <span class="text-[11px] font-semibold uppercase tracking-[0.28em] text-primary">Imagery</span>
        <h2 class="mt-3 font-[var(--font-display)] text-3xl font-bold tracking-tight text-foreground md:text-4xl">Photographs of the colliery.</h2>
        <p class="mt-3 leading-relaxed text-muted-foreground">Our own photography, free to use with attribution. Open any image for the full-resolution file.</p>
      </div>
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {imagery.map((im) => (
          <figure class="group overflow-hidden rounded-2xl border border-white/10 bg-white/[0.04] transition-all hover:-translate-y-0.5 hover:border-primary/30">
            <a href={im.src} target="_blank" rel="noopener noreferrer" title="Open full resolution">
              <img src={im.src} alt={im.title} loading="lazy" class="aspect-[16/10] w-full object-cover transition-transform duration-300 group-hover:scale-[1.02]" />
            </a>
            <figcaption class="p-5">
              <div class="font-[var(--font-display)] text-[15px] font-semibold text-foreground">{im.title}</div>
              <p class="mt-1.5 text-[13px] leading-relaxed text-muted-foreground">{im.cap}</p>
              <a href={im.src} download class="mt-3 inline-flex items-center gap-1.5 text-[12px] font-semibold text-primary hover:underline">Download
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v12m0 0 4-4m-4 4-4-4M4 21h16"/></svg>
              </a>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section class="relative bg-background pb-24">
    <div class="mx-auto max-w-6xl px-6">
      <div class="grid gap-6 lg:grid-cols-2">
        <div class="overflow-hidden rounded-3xl border border-white/10 bg-white/[0.03]">
          <video class="aspect-video w-full object-cover" controls muted playsinline preload="metadata"
            poster={`${DOCS}/amlabad-drone-1.jpg?v=2`} aria-label="Aerial footage of the Amlabad colliery">
            <source src={`${DOCS}/amlabad-drone-1.mp4?v=2`} type="video/mp4" />
          </video>
          <div class="p-6">
            <div class="font-[var(--font-display)] text-lg font-semibold text-foreground">Drone footage — the Amlabad colliery</div>
            <p class="mt-2 text-sm leading-relaxed text-muted-foreground">About 22 seconds, 1080p, no audio. Free to use with attribution.</p>
            <a href={`${DOCS}/amlabad-drone-1.mp4?v=2`} download class="mt-3 inline-flex items-center gap-1.5 text-[13px] font-semibold text-primary hover:underline">Download the clip
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v12m0 0 4-4m-4 4-4-4M4 21h16"/></svg>
            </a>
          </div>
        </div>

        <div class="rounded-3xl border border-white/10 bg-white/[0.03] p-7">
          <span class="text-[11px] font-semibold uppercase tracking-[0.28em] text-primary">Brand marks</span>
          <h3 class="mt-3 font-[var(--font-display)] text-xl font-bold text-foreground">Logo and chevron</h3>
          <p class="mt-2 text-sm leading-relaxed text-muted-foreground">Please use these unaltered — no recolouring, stretching or added effects. On dark grounds the chevron reads best on its own.</p>
          <div class="mt-6 grid grid-cols-2 gap-4">
            <div class="rounded-2xl border border-white/10 bg-neutral-100 p-6 text-center">
              <img src="/mangalam_logo.png" alt="Mangalam Coalfield full logo" class="mx-auto h-24 w-auto object-contain" loading="lazy" />
              <a href="/mangalam_logo.png" download class="mt-4 inline-block text-[12px] font-semibold text-[#2c5c2c] hover:underline">Full logo (PNG)</a>
            </div>
            <div class="rounded-2xl border border-white/10 p-6 text-center" style="background:linear-gradient(150deg,#173a22,#0b0e0b)">
              <img src="/mangalam_mark.png" alt="Mangalam chevron mark" class="mx-auto h-24 w-auto object-contain" loading="lazy" />
              <a href="/mangalam_mark.png" download class="mt-4 inline-block text-[12px] font-semibold text-primary hover:underline">Chevron (PNG)</a>
            </div>
          </div>
          <p class="mt-6 text-[12px] leading-relaxed text-muted-foreground/60">Press coverage of the revival is collected on our <a href="/news" class="text-primary hover:underline">news page</a>. Those clippings stay with their publishers, so we link to them rather than offer them for download.</p>
        </div>
      </div>
    </div>
  </section>
</Site>
