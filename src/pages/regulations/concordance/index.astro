---
import Site from '../../../layouts/Site.astro';
import RegNav from '../../../components/RegNav.astro';
import { CONCORDANCES } from '../../../data/concordances';

// The concordances in one place: where each provision of an old instrument went in its
// replacement, with what changed. Each is built by tools/build_concordance.py.
const files = import.meta.glob('../../../data/concordance-*.json', { eager: true }) as Record<string, { default: { rows: { change?: string }[] } }>;
const cards = CONCORDANCES.map((m) => {
  const rows = files[`../../../data/concordance-${m.key}.json`].default.rows;
  const n = (k: string) => rows.filter((r) => (r.change ?? 'gone') === k).length;
  return { m, total: rows.length, same: n('same') + n('minor'), changed: n('expanded') + n('revised') + n('merged'), gone: n('gone') };
});
const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://mangalamcoal.com/' },
    { '@type': 'ListItem', position: 2, name: 'Regulations', item: 'https://mangalamcoal.com/regulations' },
    { '@type': 'ListItem', position: 3, name: 'What changed', item: 'https://mangalamcoal.com/regulations/concordance' },
  ],
};
---
<Site title="What changed: concordances of Indian mining law" description="Where each provision of the old mining and electrical safety laws went in the instruments that replace them — CMR 2017 to the Draft OSH&WC (Coal Mines) Regulations 2026, the Mines Rules 1955 to the OSH&WC Central Rules 2026, and more — with a word-by-word comparison." jsonLd={breadcrumbLd}>
  <section class="relative bg-background pb-24 pt-28">
    <div class="mx-auto max-w-6xl px-6">
      <RegNav active="concordance" class="mb-8" />
      <div class="max-w-3xl">
        <span class="text-[11px] font-semibold uppercase tracking-[0.28em] text-primary">Regulation desk · what changed</span>
        <h1 class="mt-2 font-[var(--font-display)] text-3xl font-bold leading-tight tracking-tight text-foreground md:text-4xl">Where the old law went</h1>
        <p class="mt-3 text-muted-foreground">Mining law is moving from the Mines Act and its rules to the OSH&amp;WC Code and the instruments under it. Each concordance takes an old instrument provision by provision, shows where it now sits in its replacement, and what changed in the words. Machine-assisted and labelled so: check both texts before relying on a match.</p>
      </div>
      <div class="mt-10 grid gap-4 md:grid-cols-2">
        {cards.map(({ m, total, same, changed, gone }) => (
          <a href={`/regulations/concordance/${m.key}`} class="group flex flex-col rounded-3xl border border-white/10 bg-white/[0.03] p-6 transition-all hover:-translate-y-1 hover:border-primary/40">
            <div class="flex items-start justify-between gap-3">
              <h2 class="font-[var(--font-display)] text-lg font-semibold leading-snug text-foreground group-hover:text-primary">{m.heading}</h2>
              {m.draft && <span class="shrink-0 rounded-full bg-secondary/20 px-2.5 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-[#9ed3c4]">Draft</span>}
            </div>
            <p class="mt-2 flex-1 text-[13px] leading-relaxed text-muted-foreground">{m.context}</p>
            <div class="mt-4 flex flex-wrap gap-x-4 gap-y-1 text-[12px]">
              <span class="text-foreground/80"><span class="font-semibold text-foreground">{total}</span> {m.fromUnit.toLowerCase()}s</span>
              <span class="text-primary">{same} kept</span>
              <span class="text-[#e0b86a]">{changed} changed</span>
              <span class="text-[#e8a090]">{gone} not carried over</span>
            </div>
            <span class="mt-4 text-[12px] font-semibold text-primary">See each {m.fromUnit.toLowerCase()} →</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</Site>
